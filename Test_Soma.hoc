usegui = 1

{load_file("stdlib.hoc")}
{load_file("stdgui.hoc")}


create Soma
access Soma

celsius = 6.3

Soma {pt3dclear() pt3dadd(0.0, 0, 0.0, 12.9228) pt3dadd(0.0, 12.9228, 0.0, 12.9228)}
define_shape()

forall Ra = 100
forall cm = 1.5

insert pas 
{ g_pas=2.47789e-05 }
{ e_pas=-52 }


insert egl19
{ gbar_egl19=0.000190607 }

insert slo1egl19
{ gbar_slo1egl19=3.81214e-15 }



if (ismembrane("k_ion")) { ek = -85 }
if (ismembrane("na_ion")) { ena = 50 }

insert cadiff

proc initialiseValues0() {

    forall  v = -70
    forall  cai = .0001

}

objref fih0
{fih0 = new FInitializeHandler(0, "initialiseValues0()")}

objref stim1 
objref stim2 


Soma {
    stim1 = new IClamp(0.5)
    stim1.del = 100.0
    stim1.dur = 500.0
    stim1.amp = 0.005
    
    //stim2 = new IClamp(0.5)
    //stim2.del = 300.0
    //stim2.dur = 100.0
    //stim2.amp = 0.05
}



tstop = 700.0
dt = 0.01


objref v_time
objref f_time

v_time = new Vector()
{ v_time.record(&t) }
//{ v_time.resize(70001) } // false
f_time = new File()


objref Soma_v
{ Soma_v = new Vector() }
{ Soma_v.record(&Soma.v(0.5))} 

objref Soma_ca
{ Soma_ca = new Vector() }
{ Soma_ca.record(&Soma.cai(0.5))} 

objref Soma_eca
{ Soma_eca = new Vector() }
{ Soma_eca.record(&Soma.eca(0.5))} 

objref Soma_m_egl19
{ Soma_m_egl19 = new Vector() }
{ Soma_m_egl19.record(&Soma.m_egl19(0.5))} 

objref Soma_h_egl19
{ Soma_h_egl19 = new Vector() }
{ Soma_h_egl19.record(&Soma.h_egl19(0.5))} 

objref Soma_slo1egl19_m_egl19
{ Soma_slo1egl19_m_egl19 = new Vector() }
{ Soma_slo1egl19_m_egl19.record(&Soma.mca_slo1egl19(0.5))} 

objref Soma_m_slo1egl19
{ Soma_m_slo1egl19 = new Vector() }
{ Soma_m_slo1egl19.record(&Soma.m_slo1egl19(0.5))} 

objref vkcmCALC_slo1egl19
{ vkcmCALC_slo1egl19 = new Vector() }
{ vkcmCALC_slo1egl19.record(&Soma.kcmCALC_slo1egl19(0.5))} 


objref vkomCALC_slo1egl19
{ vkomCALC_slo1egl19 = new Vector() }
{ vkomCALC_slo1egl19.record(&Soma.komCALC_slo1egl19(0.5))} 


objref vkopCALC_slo1egl19
{ vkopCALC_slo1egl19 = new Vector() }
{ vkopCALC_slo1egl19.record(&Soma.kopCALC_slo1egl19(0.5))} 


objref f_Soma_v

objref GraphWin_0
objref GraphWin_1
objref GraphWin_2
objref GraphWin_3

if (usegui==1) {
    GraphWin_0 = new Graph(0)
    {GraphWin_0.size(0, tstop,-80.0,70.0)}
    {GraphWin_0.view(0, -80.0, tstop, 150.0, 80, 330, 330, 250)}
    {
        GraphWin_0.addexpr("Soma.v", "Soma.v(0.5)", 1, 1, 0.8, 0.9, 2)
        graphList[0].append(GraphWin_0)
    }

    GraphWin_1 = new Graph(0)
    {GraphWin_1.size(0, tstop,-0.1,1.1)}
    {GraphWin_1.view(0, -0.1, tstop, 1.2, 80, 330, 330, 250)}
    {
        GraphWin_1.addexpr("m_egl19", "m_egl19", 1, 1, 0.8, 0.9, 2)
        GraphWin_1.addexpr("h_egl19", "h_egl19", 2, 1, 0.8, 0.9, 2)

        GraphWin_1.addexpr("m_slo1egl19", "m_slo1egl19", 3, 1, 0.8, 0.9, 2)
        GraphWin_1.addexpr("mca_slo1egl19", "mca_slo1egl19", 4, 1, 0.8, 0.9, 2)


        GraphWin_1.addexpr("kcmCALC_slo1egl19", "kcmCALC_slo1egl19", 5, 1, 0.8, 0.9, 2)
        GraphWin_1.addexpr("komCALC_slo1egl19", "komCALC_slo1egl19", 6, 1, 0.8, 0.9, 2)
        GraphWin_1.addexpr("kopCALC_slo1egl19", "kopCALC_slo1egl19", 7, 1, 0.8, 0.9, 2)
        //


        //GraphWin_1.addexpr("m_Im", "m_Im", 2, 1, 0.8, 0.9, 2)
        //GraphWin_1.addexpr("m_KdShu2007", "m_KdShu2007", 3, 1, 0.8, 0.9, 2)
        //GraphWin_1.addexpr("h_KdShu2007", "h_KdShu2007", 4, 1, 0.8, 0.9, 2)
        //GraphWin_1.addexpr("m_Ca", "m_Ca", 5, 1, 0.8, 0.9, 2)
        //GraphWin_1.addexpr("h_Ca", "h_Ca", 6, 1, 0.8, 0.9, 2)
        graphList[0].append(GraphWin_1)
    }

    GraphWin_2 = new Graph(0)
    {GraphWin_2.size(0, tstop,0,0.005)}
    {GraphWin_2.view(0, 0, tstop, 0.005, 80, 330, 330, 250)}
    {
        GraphWin_2.addexpr("cai", "cai", 1, 1, 0.8, 0.9, 2)
        GraphWin_2.addexpr("caCALC_slo1egl19", "caCALC_slo1egl19", 2, 1, 0.8, 0.9, 2)
        graphList[0].append(GraphWin_2)
    }

    GraphWin_3 = new Graph(0)
    {GraphWin_3.size(0, tstop,-100,100)}
    {GraphWin_3.view(0, 70, tstop, 60, 80, 330, 330, 250)}
    {
        GraphWin_3.addexpr("eca", "eca", 1, 1, 0.8, 0.9, 2)
        graphList[0].append(GraphWin_3)
    }
}

{run()}

strdef timeFilename


f_Soma_v = new File()
strdef filename
{sprint(filename, "Soma.dat")}
f_Soma_v.wopen(filename)
Soma_v.printf(f_Soma_v)
f_Soma_v.close()



{ sprint(timeFilename, "%s",  "time.dat")}
{ f_time.wopen(timeFilename) }
{ v_time.printf(f_time) }
{ f_time.close() }

objref f_Soma_si
f_Soma_si = new File()
{ f_Soma_si.wopen("Soma.si.dat") }
for i=0, Soma_v.size()-1 {
   f_Soma_si.printf("%f\t%f\n", v_time.x[i]/1000, Soma_v.x[i]/1000)
}
{ f_Soma_si.close() }


objref f_Soma_ca
f_Soma_ca = new File()
{ f_Soma_ca.wopen("Soma.ca.dat") }
for i=0, Soma_ca.size()-1 {
   f_Soma_ca.printf("%f\t%f\n", v_time.x[i]/1000, Soma_ca.x[i])
}
{ f_Soma_ca.close() }


objref f_Soma_eca
f_Soma_eca = new File()
{ f_Soma_eca.wopen("Soma.eca.dat") }
for i=0, Soma_eca.size()-1 {
   f_Soma_eca.printf("%f\t%f\n", v_time.x[i]/1000, Soma_eca.x[i]/1000)
}
{ f_Soma_eca.close() }



objref f_Soma_chans
f_Soma_chans = new File()
{ f_Soma_chans.wopen("Soma.chans.dat") }
for i=0, Soma_m_egl19.size()-1 {
   f_Soma_chans.printf("%f\t%f\t%f\t%f\t%f\n", v_time.x[i]/1000, Soma_m_egl19.x[i], Soma_h_egl19.x[i], Soma_slo1egl19_m_egl19.x[i], Soma_m_slo1egl19.x[i])
}
{ f_Soma_chans.close() }


objref f_Soma_vars
f_Soma_vars = new File()
{ f_Soma_vars.wopen("Soma.vars.dat") }

for i=0, vkcmCALC_slo1egl19.size()-1 {
   f_Soma_vars.printf("%f\t%f\t%f\t%f\n", v_time.x[i]/1000, vkcmCALC_slo1egl19.x[i], vkomCALC_slo1egl19.x[i], vkopCALC_slo1egl19.x[i])
}
{ f_Soma_vars.close() }



if (usegui==1) {
    //   This code pops up a simple Run Control

    {
    xpanel("RunControl", 0)
    v_init = -60.0
    xbutton("Init & Run","run()")
    xbutton("Stop","stoprun=1")
    t = 0
    xvalue("t","t", 2 )
    tstop = 700.0
    xvalue("Tstop","tstop", 1,"tstop_changed()", 0, 1 )
    dt = 0.01
     xvalue("dt","dt", 1,"setdt()", 0, 1 )
    xpanel(80,80)
    }
}

forall psection()
