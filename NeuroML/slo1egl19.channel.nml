<neuroml xmlns="http://www.neuroml.org/schema/neuroml2"  xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.neuroml.org/schema/neuroml2 https://raw.github.com/NeuroML/NeuroML2/development/Schemas/NeuroML2/NeuroML_v2.3.1.xsd" id="kqt1">
    <notes>An ion channel from cell AIY from Nicoletti et al. 2024</notes>

    <ionChannelHH id="slo1egl19" species="k" conductance="10 pS">
    
    

        <gate id="m" instances="1" type="gateHHtauInf">
            <timeCourse type="slo1_m_tau"/>
            <steadyState type="slo1_m_inf"/>
        </gate>
        
      
    
        <gate id="h" instances="1" type="gateHHtauInf">
            <timeCourse type="slo1_h_tau"/>
            <steadyState type="slo1_h_inf"/>
        </gate>
        
    </ionChannelHH>

  
    <ComponentType name="slo1_m_inf" extends="baseVoltageDepVariable">
        <Constant name="VOLT_SCALE" dimension="voltage" value="1 mV"/>
        <Constant name="TIME_SCALE" dimension="time" value="1 ms"/>
        <Constant name="backgr" dimension="none" value="0.05"/>
        <Constant name="d" dimension="none" value="250e-12"/>
        <Constant name="pi" dimension="none" value="3.14"/>
        <Constant name="F" dimension="none" value="96485.0"/>
        <Constant name="kb" dimension="none" value="500e6"/>
        <Constant name="gsc" dimension="none" value="40e-12"/>
        <Constant name="r" dimension="none" value="13e-9"/>
        <Constant name="b" dimension="none" value="30e-06"/>
        <Constant name="eca" dimension="none" value="60.0"/>
        <Constant name="va_egl19" dimension="none" value="5.6"/>
        <Constant name="ka_egl19" dimension="none" value="7.5"/>
        <Constant name="stm19" dimension="none" value="10.0"/>
        <Constant name="pdg1" dimension="none" value="2.3359"/>
        <Constant name="pdg2" dimension="none" value="2.9324"/>
        <Constant name="pdg3" dimension="none" value="5.2357"/>
        <Constant name="pdg4" dimension="none" value="6.0"/>
        <Constant name="pdg5" dimension="none" value="1.8739"/>
        <Constant name="pdg6" dimension="none" value="1.3930"/>
        <Constant name="pdg7" dimension="none" value="30.0"/>
        <Constant name="stau19" dimension="none" value="10.0"/>
        <Constant name="wop" dimension="none" value="0.156217"/>
        <Constant name="wxy" dimension="none" value="-0.027527"/>
        <Constant name="kxy" dimension="none" value="55.726186"/>
        <Constant name="nxy" dimension="none" value="1.299198"/>
        <Constant name="nyx" dimension="none" value="0.000100"/>
        <Constant name="kyx" dimension="none" value="34.338784"/>
        <Constant name="wom" dimension="none" value="3.152961"/>
        <Constant name="wyx" dimension="none" value="0.012643"/>
        <Dynamics>
            <StateVariable name="m_egl19" dimension="none"/>
            <DerivedVariable name="V" dimension="none" value="(v) / VOLT_SCALE"/>
            <DerivedVariable name="cac_nano" dimension="none" value="0.0001"/>
            <DerivedVariable name="cao_nano" dimension="none" value="(((abs(gsc*(V - eca)*1e-3)/(8*pi*F*d*r))*exp(-r/(sqrt(d/(b*kb)))))*1e6*1e-3) + backgr"/>
            <DerivedVariable name="actegl19" dimension="none"  value="1/(1+exp(-(V-va_egl19+stm19)/ka_egl19))"/>
            <DerivedVariable name="tactegl19" dimension="none"  value="(pdg1+(pdg2*exp(-(V-pdg3+stau19)^2/(pdg4)^2))+(pdg5*exp(-(V-pdg6+stau19)^2/(pdg7)^2)))"/>
            <DerivedVariable name="kop2" dimension="none" value="wop*exp(-V*wxy)/((kxy/cao_nano)^nxy + 1)"/>
            <DerivedVariable name="kcm2" dimension="none" value="wom*exp(-V*wyx)/((backgr/kyx)^nyx + 1)"/>
            <DerivedVariable name="kom2" dimension="none" value="wom*exp(-V*wyx)/((cao_nano/kyx)^nyx + 1)"/>
            <DerivedVariable name="alpha1" dimension="none" value="actegl19/tactegl19"/>
            <DerivedVariable name="beta1" dimension="none" value="-alpha1 + 1/tactegl19"/>
            <DerivedVariable name="x" dimension="none" exposure="x" value="kop2*m_egl19*(alpha1 + beta1 + kcm2)/(beta1*kcm2 + (alpha1 + kcm2)*(kom2 + kop2))"/>
            <TimeDerivative variable="m_egl19" value="((-m_egl19 + actegl19)/tactegl19) / TIME_SCALE"/>
        </Dynamics>
       
    </ComponentType>

<ComponentType name="slo1_m_tau" extends="baseVoltageDepTime">
        <Constant name="VOLT_SCALE" dimension="voltage" value="1 mV"/>
        <Constant name="TIME_SCALE" dimension="time" value="1 ms"/>
        <Constant name="backgr" dimension="none" value="0.05"/>
        <Constant name="d" dimension="none" value="250e-12"/>
        <Constant name="pi" dimension="none" value="3.14"/>
        <Constant name="F" dimension="none" value="96485.0"/>
        <Constant name="kb" dimension="none" value="500e6"/>
        <Constant name="gsc" dimension="none" value="40e-12"/>
        <Constant name="r" dimension="none" value="13e-9"/>
        <Constant name="b" dimension="none" value="30e-06"/>
        <Constant name="eca" dimension="none" value="60.0"/>
        <Constant name="stm19" dimension="none" value="10.0"/>
        <Constant name="pdg1" dimension="none" value="2.3359"/>
        <Constant name="pdg2" dimension="none" value="2.9324"/>
        <Constant name="pdg3" dimension="none" value="5.2357"/>
        <Constant name="pdg4" dimension="none" value="6.0"/>
        <Constant name="pdg5" dimension="none" value="1.8739"/>
        <Constant name="pdg6" dimension="none" value="1.3930"/>
        <Constant name="pdg7" dimension="none" value="30.0"/>
        <Constant name="stau19" dimension="none" value="10.0"/>
        <Constant name="wop" dimension="none" value="0.156217"/>
        <Constant name="wxy" dimension="none" value="-0.027527"/>
        <Constant name="kxy" dimension="none" value="55.726186"/>
        <Constant name="nxy" dimension="none" value="1.299198"/>
        <Constant name="nyx" dimension="none" value="0.000100"/>
        <Constant name="kyx" dimension="none" value="34.338784"/>
        <Constant name="wom" dimension="none" value="3.152961"/>
        <Constant name="wyx" dimension="none" value="0.012643"/>
        <Constant name="stm19" dimension="none" value="10.0"/>
        <Constant name="sth19" dimension="none" value="10.0"/>
        <Constant name="stau19" dimension="none" value="10.0"/>
        <Constant name="pds1" dimension="none" value="0.4"/>
        <Constant name="pds2" dimension="none" value="0.55"/>
        <Constant name="pds3" dimension="none" value="81.1179"/>
        <Constant name="pds4" dimension="none" value="-22.9723"/>
        <Constant name="pds5" dimension="none" value="5.0"/>
        <Constant name="pds6" dimension="none" value="43.0937"/>
        <Constant name="pds7" dimension="none" value="0.9"/>
        <Constant name="pds8" dimension="none" value="40.4885"/>
        <Constant name="pds9" dimension="none" value="28.7251"/>
        <Constant name="pds10" dimension="none" value="3.7125"/>
        <Constant name="pds11" dimension="none" value="0.0"/>
        <Constant name="shiftdps" dimension="none" value="10.0"/>
        <Constant name="d" dimension="none" value="250e-12"/>
        <Constant name="pi" dimension="none" value="3.14"/>
        <Constant name="F" dimension="none" value="96485.0"/>
        <Constant name="kb" dimension="none" value="500e6"/>
        <Constant name="gsc" dimension="none" value="40e-12"/>
        <Constant name="eca" dimension="none" value="60.0"/>
        <Constant name="va_egl19" dimension="none" value="5.6"/>
        <Constant name="ka_egl19" dimension="none" value="7.5"/>
        <Constant name="p1hegl19" dimension="none" value="1.4314"/>
        <Constant name="p2hegl19" dimension="none" value="24.8573"/>
        <Constant name="p3hegl19" dimension="none" value="11.9541"/>
        <Constant name="p4hegl19" dimension="none" value="0.1427"/>
        <Constant name="p5hegl19" dimension="none" value="5.9589"/>
        <Constant name="p6hegl19" dimension="none" value="-10.5428"/>
        <Constant name="p7hegl19" dimension="none" value="8.0552"/>
        <Constant name="p8hegl19" dimension="none" value="0.6038"/>
        <Dynamics>
            <DerivedVariable name="V" dimension="none" value="(v) / VOLT_SCALE"/>   
            <DerivedVariable name="kcm2" dimension="none" value="wom*exp(-V*wyx)/((backgr/kyx)^nyx + 1)"/>
            <DerivedVariable name="cac_nano" dimension="none" value="0.0001"/>
            <DerivedVariable name="cao_nano" dimension="none" value="(((abs(gsc*(V - eca)*1e-3)/(8*pi*F*d*r))*exp(-r/(sqrt(d/(b*kb)))))*1e6*1e-3) + backgr"/>
            <DerivedVariable name="kom2" dimension="none" value="wom*exp(-V*wyx)/((cao_nano/kyx)^nyx + 1)"/>
            <DerivedVariable name="kop2" dimension="none" value="wop*exp(-V*wxy)/((kxy/cao_nano)^nxy + 1)"/>
            <DerivedVariable name="tactegl19" dimension="none" value="pdg1 + pdg2*exp(-(V - pdg3 + stau19)^2/pdg4^2) + pdg5*exp(-(V - pdg6 + stau19)^2/pdg7^2)"/>
            <DerivedVariable name="actegl19" dimension="none" value="1/(exp((-V - stm19 + va_egl19)/ka_egl19) + 1)"/>
            <DerivedVariable name="alpha1" dimension="none" value="actegl19/tactegl19"/>
            <DerivedVariable name="beta1" dimension="none" value="-alpha1 + 1/tactegl19"/>
            <DerivedVariable name="t" dimension="time" exposure="t" value="((alpha1 + beta1 + kcm2)/(beta1*kcm2 + (alpha1 + kcm2)*(kom2 + kop2)))* TIME_SCALE"/>
        </Dynamics>
    </ComponentType>



<ComponentType name="slo1_h_inf" extends="baseVoltageDepVariable">
        <Constant name="VOLT_SCALE" dimension="voltage" value="1 mV"/>
        <Constant name="TIME_SCALE" dimension="time" value="1 ms"/>
        <Constant name="backgr" dimension="none" value="0.05"/>
        <Constant name="d" dimension="none" value="250e-12"/>
        <Constant name="pi" dimension="none" value="3.14"/>
