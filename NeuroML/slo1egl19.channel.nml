        <Constant name="p8hegl19" dimension="none" value="0.6038"/>

        <Dynamics>
            <DerivedVariable name="cac_nano" dimension="none" value="0.0001"/>
            <DerivedVariable name="V" dimension="none" value="(v) / VOLT_SCALE"/>
            <DerivedVariable name="tactegl19" dimension="none" value="pdg1 + pdg2*exp(-(V - pdg3 + stau19)^2/pdg4^2) + pdg5*exp(-(V - pdg6 + stau19)^2/pdg7^2)"/>
            <DerivedVariable name="actegl19" dimension="none" value="1/(exp((-V - stm19 + va_egl19)/ka_egl19) + 1)"/>
            <DerivedVariable name="alpha1" dimension="none" value="actegl19/tactegl19"/>
            <DerivedVariable name="t" dimension="time" exposure="t" value="(pds1*(pds11 + pds2*pds3/(exp((V - pds4 + shiftdps)/pds5) + 1) + pds6 + pds7*pds8/(exp((V - pds9 + shiftdps)/pds10) + 1)))* TIME_SCALE"/>
        </Dynamics>
